###########################
# Environment Example File
###########################
# Copy this file to `.env` before running the project:
#   cp .env.example .env
# All values below work out of the box for local development.

# --- Database (MySQL container) ---
# Nao defina MYSQL_USER=root: a imagem do MySQL 8 recusa e o container entra
# em restart loop. O backend conecta como root usando a senha abaixo.
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=TechAcademy5

# --- Backend DB connection (used by backend container) ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=TechAcademy5
DB_USER=root
DB_PASSWORD=rootpassword

# --- Notifications DB (used by notifications container) ---
NOTIFICATIONS_DB_ROOT_PASSWORD=rootpassword
NOTIFICATIONS_DB_NAME=pcforge_notificacoes

# --- Redis (cache distribuido e mensageria) ---
REDIS_URL=redis://redis:6379

# --- JWT ---
JWT_SECRET=pcforge_dev_secret_2026

# --- Frontend ---
REACT_APP_API_URL=https://pcforge.local/api

# Formulario de suporte do front web (painel do EmailJS).
# O app mobile le as mesmas credenciais em TechAcademy5mobile/.env, com o
# prefixo EXPO_PUBLIC_. Trocar a chave exige atualizar os dois.
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_TEMPLATE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=

# --- CORS ---
# Origens que o navegador pode usar para chamar a API, separadas por virgula.
# Deixe vazio para aceitar qualquer origem. O app mobile nativo nao envia
# header Origin e nao depende desta lista. A porta 8081 e o Expo no navegador.
CORS_ORIGINS=https://pcforge.local,http://localhost:3001,http://localhost:8081

# --- Environment ---
NODE_ENV=development

# --- Optional (third-party integrations) ---
MERCADO_PAGO_ACCESS_TOKEN=
FRONTEND_URL=https://pcforge.local
APP_HOST=pcforge.local